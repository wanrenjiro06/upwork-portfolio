<?xml version="1.0" encoding="utf-8"?>
<!--
  Demo host for BirthdayCelebrationView. The view is fully self-contained
  (it draws the cake, candles, balloons, confetti, sparkles AND the text),
  so this layout just hosts it full-screen on the dark POS background and
  adds a small name field + Celebrate button for the demo. In production the
  POS would simply call birthdayView.celebrate(customerName) — no controls.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/birthdayBg"
    android:fitsSystemWindows="true">

    <com.posdemo.spinwheel.BirthdayCelebrationView
        android:id="@+id/birthdayView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <EditText
            android:id="@+id/nameInput"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:autofillHints="name"
            android:background="@color/ink2"
            android:hint="Customer name"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="18"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:text="Sarah"
            android:textColor="@color/textLight"
            android:textColorHint="@color/textDim"
            android:textSize="15sp" />

        <Button
            android:id="@+id/celebrateButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:backgroundTint="@color/blue"
            android:paddingHorizontal="26dp"
            android:text="Celebrate"
            android:textColor="#07223F"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
